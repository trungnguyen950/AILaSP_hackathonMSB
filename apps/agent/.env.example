GREENNODE_CLIENT_ID=
GREENNODE_CLIENT_SECRET=
GREENNODE_AGENT_IDENTITY=
# LLM (GreenNode AI Platform — get key via /agentbase-llm)
LLM_API_KEY=
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=
# Optional: AgentBase memory
MEMORY_ID=
# KB dir (default: ./knowledge_base)
KB_DIR=
# Zalo Bot Platform — bot token từ Bot Creator (format: bot_id:secret)
# Nên lưu qua AgentBase auth provider 'zalo-bot-token' (xem /agentbase-identity).
# Env var này chỉ là fallback cho local dev.
ZALO_BOT_TOKEN=
# Webhook secret token (8-256 chars) để xác thực request từ Zalo gọi về /zalo-webhook
ZALO_WEBHOOK_SECRET=
# Zalo chat_id mặc định (demo). Khi deploy, chat_id lấy tự động khi user nhắn cho bot.
ZALO_CHAT_ID=
